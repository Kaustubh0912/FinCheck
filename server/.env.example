# Copy to server/.env for local dev, or set these in your host's dashboard.

# MongoDB Atlas connection string — include a database name (e.g. /fincheck).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fincheck?retryWrites=true&w=majority"

# Port the API listens on. Render/Vercel inject PORT automatically.
PORT=4000

# Secret used to sign JWT auth tokens. Use a long random value in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: restrict CORS to specific origins (comma-separated) when the
# frontend is hosted on a different domain. Leave unset to allow all.
# CLIENT_ORIGIN="https://your-frontend.vercel.app"
