{
  "name": "fincheck",
  "private": true,
  "version": "0.1.0",
  "description": "FinCheck — a mobile-first personal finance tracker with account-aware transactions.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "predev": "node scripts/free-ports.mjs",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "start": "node scripts/start.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "npm run typecheck -w client && tsc -p server/tsconfig.json --noEmit",
    "test": "npm run test -w server && npm run test -w client",
    "test:coverage": "npm run test:coverage -w client",
    "coverage:check": "npm run coverage:check -w client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "sharp": "^0.35.2",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=20"
  }
}
